# Copy to .env. auto modes allow local fallbacks; explicit bedrock/gemini and daytona modes require their configuration.

# Daytona — sandbox that runs the approved action (app.daytona.io → Keys)
# auto: remote when available, with startup fallback; local: no Daytona; daytona: require remote
SCRAM_EXECUTOR=auto
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
# DAYTONA_SNAPSHOT=your-python-snapshot

# Arize AX — traces and evaluators (app.arize.com → Space settings → API keys)
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT=scram
# auto exports when credentials exist; local disables network telemetry.
SCRAM_TRACE_MODE=auto

# SurrealDB — mem:// runs embedded in-process (no server). Or ws://localhost:8000/rpc, or a Surreal Cloud URL.
SURREAL_URL=mem://
SURREAL_USER=
SURREAL_PASS=
SURREAL_NS=scram
SURREAL_DB=scram

# SurrealDB Agent Memory (hosted) — time-aware facts about the reactor (studio.surrealdb.com → Agent Memory →
# your context: the host, the context id, and a key from API keys). Off unless all three are set.
SPECTRON_URL=
SPECTRON_CONTEXT_ID=
SPECTRON_API_KEY=
AGENT_MEMORY_SCOPE=

# ElevenLabs — used by scripts/make_voice_clips.py
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# Anchor Browser — governed read-only page fetch in case C1
ANCHOR_API_KEY=
# NC-01 permits only HTTPS URLs on www.nrc.gov. Other targets are blocked.
ANCHOR_READ_URL=https://www.nrc.gov/about-nrc/news-releases/2026

# Model provider — only parses the request. Deterministic code decides policy.
# auto: Gemini when its key exists, otherwise prepared actions. prepared: never call a model.
# bedrock/gemini: require that provider; failures block with PARSE_UNCERTAIN.
SCRAM_MODEL_PROVIDER=auto
# Bedrock uses the normal AWS SDK credential chain. On ECS, attach an IAM task role.
# Locally, use an AWS profile/SSO or standard AWS environment variables; never put keys in web/.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Gemini remains available with auto or SCRAM_MODEL_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

STEP_SECONDS=0.9
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
