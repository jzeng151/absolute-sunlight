# Copy to .env. Every key is optional: without it, that integration falls back and /api/health says so.

# Arize AX — traces and evaluators (app.arize.com → Space settings → API keys)
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT=scram
# auto exports when credentials exist; local disables network telemetry.
SCRAM_TRACE_MODE=auto

STEP_SECONDS=0.9
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
