# Copy to .env. Every key is optional: without it, that integration falls back and /api/health says so.

# Daytona — sandbox that runs the approved action (app.daytona.io → Keys)
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us

# Arize AX — traces and evaluators (app.arize.com → Space settings → API keys)
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT=scram

# SurrealDB — mem:// runs embedded in-process (no server). Or ws://localhost:8000/rpc, or a Surreal Cloud URL.
SURREAL_URL=mem://
SURREAL_USER=
SURREAL_PASS=
SURREAL_NS=scram
SURREAL_DB=scram

# ElevenLabs — used by scripts/make_voice_clips.py
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# Anchor Browser — governed read-only page fetch in case C1
ANCHOR_API_KEY=
ANCHOR_READ_URL=https://www.nrc.gov/about-nrc/news-releases/2026

# Gemini (free tier, aistudio.google.com) — parses the request. Never decides policy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

STEP_SECONDS=0.9
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
